{
  "manifest_version": 3,
  "name": "Copy Active Tab URL",
  "version": "1.0.0",
  "description": "現在のアクティブタブのURLをクリップボードへコピーします。",
  "permissions": ["activeTab", "clipboardWrite", "scripting"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "現在のURLをコピー",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "81898958-f115-4681-89eb-437a97fb4199",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
